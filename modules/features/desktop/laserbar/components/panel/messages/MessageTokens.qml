import QtQuick

// The themed values, as properties. Non-visual.
//
// This exists for the render fixtures. A fixture is copied into the tree as
// shell.qml WITHOUT the @token@ substitution - only files generated by
// modules/lib/qml-theme.nix get that - so a fixture cannot write "@sheetBg@"
// and cannot know which variant it is being rendered in.
//
// The first version of the sidebar fixture spelled the dark sheet out as
// #EF000000, which meant the light render drew light-variant text on a
// near-black ground and looked broken while the component was fine. A fixture
// that lies in one variant is worse than no fixture in that variant.
//
// Nothing in the panel itself should use this: components are substituted
// directly and reading a colour through an extra object only adds a binding.
Item {
    readonly property color sheetBg: "@sheetBg@"
    readonly property color plateBg: "@plateBg@"
    readonly property color glassBorder: "@glassBorder@"
    readonly property color ink: "@clockColor@"
    readonly property color muted: "@mutedColor@"
    readonly property color accent: "@msgAccent@"
    readonly property color accentInk: "@msgAccentInk@"

    // Deliberately no hue pool here. MessageHue owns that, because the raw
    // token is not what anything draws with - the slots are corrected against
    // the sheet first. A second copy of the list here would hand fixtures the
    // uncorrected colours and quietly disagree with the panel.
}

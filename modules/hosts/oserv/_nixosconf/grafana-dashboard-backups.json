{
  "id": null,
  "uid": "oserv-backups",
  "title": "oserv backups",
  "tags": [
    "oserv",
    "backup"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed borg jobs",
      "description": "borgbackup-job-*.service units systemd currently considers failed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "all OK", "index": 0 } }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(node_systemd_unit_state{name=~\"borgbackup-job-.*\\\\.service\", state=\"failed\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest borg archive",
      "description": "Age of the newest archive in whichever repository is furthest behind. Amber past 36h, red past 48h — the jobs run daily.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 129600 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(time() - borg_repo_last_archive_timestamp_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest Time Machine",
      "description": "Age of the newest write into whichever Mac's sparsebundle is furthest behind. Time Machine backs up hourly; amber past 12h, red past 48h to allow for a laptop simply being away.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(time() - timemachine_last_backup_timestamp_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backup pool free",
      "description": "Free space on @BACKUP_PATH@ (the zpool every borg repository lives on).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 107374182400 },
              { "color": "green", "value": 322122547200 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(node_filesystem_avail_bytes{mountpoint=\"@BACKUP_PATH@\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Backup pool used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - 100 * sum(node_filesystem_avail_bytes{mountpoint=\"@BACKUP_PATH@\"}) / sum(node_filesystem_size_bytes{mountpoint=\"@BACKUP_PATH@\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Metrics age",
      "description": "How long ago backup-metrics.service last ran. Everything on this dashboard except the systemd and filesystem panels is exactly this stale. The timer fires every 15 minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - backup_collector_last_run_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Disk space",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Usage by mount",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - 100 * sum by (mountpoint) (node_filesystem_avail_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"}) / sum by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Free space trend",
      "description": "The panel that answers \"when does this fill up\". Widen the time range to a month or a year; a straight line sloping down has an x-intercept.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 7, "w": 16, "h": 8 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (mountpoint) (node_filesystem_avail_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Filesystems",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 6 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Size" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Used" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Free" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Used %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "gauge", "mode": "gradient" }
              },
              { "id": "max", "value": 100 },
              { "id": "min", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 80 },
                    { "color": "red", "value": 90 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"} - node_filesystem_avail_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (mountpoint) (node_filesystem_avail_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - 100 * sum by (mountpoint) (node_filesystem_avail_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"}) / sum by (mountpoint) (node_filesystem_size_bytes{mountpoint=~\"@SSD_PATH@|@HDD_PATH@|@BACKUP_PATH@\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "mountpoint", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "mountpoint": "Mount",
              "Value #A": "Size",
              "Value #B": "Used",
              "Value #C": "Free",
              "Value #D": "Used %"
            }
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Borg repositories",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "Repositories",
      "description": "One row per repository in services.borgbackup.repos, including laptop-document-backup, which personal pushes here over ssh. A blank age means the repository holds no archive yet; Read = ERROR means borg could not open it on the last collection (often just a backup holding the lock).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 22, "w": 14, "h": 9 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Last archive age" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 129600 },
                    { "color": "red", "value": 172800 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Size on disk" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "Read" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "ERROR", "color": "red", "index": 0 },
                      "1": { "text": "OK", "color": "green", "index": 1 }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (repo) (time() - borg_repo_last_archive_timestamp_seconds)",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (repo) (borg_repo_archive_count)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (repo) (borg_repo_disk_usage_bytes)",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (repo) (borg_repo_collect_success)",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "repo", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "repo": "Repository",
              "Value #A": "Last archive age",
              "Value #B": "Archives",
              "Value #C": "Size on disk",
              "Value #D": "Read"
            }
          }
        }
      ]
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "Time since last archive",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 14, "y": 22, "w": 10, "h": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "max": 259200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 129600 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - borg_repo_last_archive_timestamp_seconds",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Repository size",
      "description": "Disk each repository occupies, as du sees it. A flat line through a daily backup means deduplication is working; a step means something large and new was taken in.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "borg_repo_disk_usage_bytes",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "type": "state-timeline",
      "title": "Borg job state",
      "description": "Whether systemd holds each borgbackup job in the failed state. node-exporter's systemd collector, not the textfile collector, so this is live rather than 15 minutes old.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OK", "color": "green", "index": 0 },
                "1": { "text": "FAILED", "color": "red", "index": 1 }
              }
            }
          ],
          "custom": { "lineWidth": 0, "fillOpacity": 85 },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name) (node_systemd_unit_state{name=~\"borgbackup-job-.*\\\\.service\", state=\"failed\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "type": "logs",
      "title": "Backup logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 9 },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{unit=~\"borgbackup-job-.*\\\\.service|backup-metrics\\\\.service\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Time Machine",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 31,
      "type": "bargauge",
      "title": "Time since last Time Machine backup",
      "description": "Newest mtime anywhere inside each Mac's sparsebundle on @TM_PATH@. Time Machine backs up hourly when the machine is awake and on the network, so a few hours is normal and a few days means the Mac has been away — or has stopped backing up.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "max": 259200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - timemachine_last_backup_timestamp_seconds",
          "legendFormat": "{{machine}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "type": "bargauge",
      "title": "Sparsebundle size",
      "description": "The Samba share caps each bundle at 500G (fruit:time machine max size), which is the scale here.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {

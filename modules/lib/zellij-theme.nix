# zellij's themes, built from modules/lib/palette.nix. Imported by
# modules/home-manager/zellij (to install them) and by
# modules/home-manager/darkman.nix (to switch them). Two files, because zellij
# switches in two different ways:
#
#   `both`        palette-dark + palette-light, static and HM-managed. These
#                 are what `theme_dark` / `theme_light` name, and what
#                 `zellij action set-dark-theme` / `set-light-theme` flips a
#                 *running* session between. Both have to resolve or that
#                 command refuses to switch at all.
#   `auto <mode>` palette-auto, the theme a *new* session starts in. darkman
#                 rewrites this file on every transition (so it is seeded, not
#                 HM-managed - a managed path is a read-only store symlink),
#                 the same pattern alacritty's colors.toml uses.
#
# Why palette-auto exists: zellij asks the terminal for its background colour
# with OSC 11 at startup and picks theme_dark/theme_light from the answer, but
# when no answer arrives it falls back to its *built-in* theme - a session
# that opens in a radioactive-green default instead of either of ours
# (reproducible: with only theme_dark/theme_light set, a fresh session paints
# with 256-colour index 154). Naming a `theme` gives that fallback a value we
# control, and darkman keeping it in sync means the fallback is also the
# correct mode.
#
# zellij needs its own themes at all - it cannot just follow alacritty like
# bat or yazi do - because it paints its chrome in true colour rather than
# through the terminal's 16 ANSI slots.
#
# The values live in palette.nix; edit them there, not here. This is zellij's
# 11-colour shorthand, which zellij expands into its ~20-slot `Styling` form
# itself. Two things about that expansion drive the mapping:
#
#   * `bg` is the chrome ground. base01 - one step up from the terminal's own
#     base00 - so the status bar reads as chrome instead of dissolving into
#     the terminal background.
#   * ribbons (the mode indicator, tab bar) paint `black` as *text* over an
#     accent or over `fg`. So `black` has to be the ground extreme, not a
#     literal black: base00, which in the light palette is the lightest value.
#     That also means every accent must contrast with base00 text, which is
#     why light mode does not take its accents from `light.ui`: the raw
#     Horizon-light slots are far too pale under light text (base0A "yellow"
#     is #FBE0D9). It uses `light.terminal.normal` instead, whose values are
#     measured at >= 7:1 against their ground. Dark mode has no such problem
#     and uses `dark.ui`, same as the bar and vicinae - except that ANSI
#     orange does not exist, so orange comes from `ui.base09` there.
{ pkgs }:
let
  palette = import ./palette.nix;

  # ground and text: structural, always the base16 slots
  ground = ui: {
    fg = ui.base05;
    bg = ui.base01;
    black = ui.base00;
    white = ui.base07;
  };

  darkAccents =
    let ui = palette.dark.ui; in
    {
      red = ui.base08;
      orange = ui.base09;
      yellow = ui.base0A;
      green = ui.base0B;
      cyan = ui.base0C;
      blue = ui.base0D;
      magenta = ui.base0E;
    };

  lightAccents =
    let n = palette.light.terminal.normal; in
    {
      red = n.red;
      # no ANSI orange; this is the measured dark orange the status widget uses
      orange = palette.light.status.degraded;
      yellow = n.yellow;
      green = n.green;
      cyan = n.cyan;
      blue = n.blue;
      magenta = n.magenta;
    };

  colorsFor = variant:
    ground palette.${variant}.ui
    // (if variant == "light" then lightAccents else darkAccents);

  renderTheme = name: variant: ''
    ${name} {
            ${
              builtins.concatStringsSep "\n        " (
                map (k: ''${k} "${(colorsFor variant).${k}}"'') [
                  "fg"
                  "bg"
                  "black"
                  "white"
                  "red"
                  "orange"
                  "yellow"
                  "green"
                  "cyan"
                  "blue"
                  "magenta"
                ]
              )
            }
        }'';

  header = ''
    // Generated from modules/lib/palette.nix by modules/lib/zellij-theme.nix.
    // Do not edit this file: edit palette.nix.
  '';
in
{
  both = pkgs.writeText "zellij-palette-themes.kdl" ''
    ${header}themes {
        ${renderTheme "palette-dark" "dark"}

        ${renderTheme "palette-light" "light"}
    }
  '';

  auto = variant: pkgs.writeText "zellij-palette-auto-${variant}.kdl" ''
    ${header}// The ${variant} palette, under the name new sessions start with.
    themes {
        ${renderTheme "palette-auto" variant}
    }
  '';
}
